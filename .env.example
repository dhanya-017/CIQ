# Copy to .env and adjust. .env is git-ignored; real environment variables override it.

# AWS: leave AWS_PROFILE empty to use the default credential chain
AWS_PROFILE=
AWS_REGION=us-east-1

# Claude on Amazon Bedrock (inference profile ID)
CIQ_MODEL=us.anthropic.claude-sonnet-5
CIQ_MODEL_LABEL=Claude Sonnet 5
# low | medium | high | xhigh | max: higher is more thorough, lower is faster and cheaper
CIQ_EFFORT=high
CIQ_MAX_TOKENS=32000
CIQ_MAX_AGENT_STEPS=12

# Profile shown at the bottom of the sidebar (there is no sign-in yet)
CIQ_USER_NAME=
CIQ_USER_EMAIL=
CIQ_USER_ROLE=Brand analytics
