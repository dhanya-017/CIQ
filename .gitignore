# Data: claims (patient-level), warehouse and saved conversations - never commit.
# Only the folder layout (.gitkeep) and Data/README.md are tracked.
Data/*
!Data/README.md
!Data/real_data/
!Data/reference/
!Data/warehouse/
!Data/conversations/
Data/real_data/*
Data/reference/*
Data/warehouse/*
Data/conversations/*
!Data/*/.gitkeep

# Notebooks embed patient-level outputs
*.ipynb

# Generated outputs that embed data aggregates
docs/tool_gallery.html

# Personal / reference documents
*.pdf

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local env / secrets
.env
*.env
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
